# Crypto Signal Bot — secrets (copy to .env and fill in)
# Public Binance market data needs NO API keys.

# Telegram bot token from @BotFather (single bot only)
TELEGRAM_TOKEN=

# Telegram chat id that receives alerts (from @userinfobot or getUpdates).
# It is ALSO the allow-list for the control commands (/scan_on, /scan_off): with
# it empty the bot authorises nobody, so those commands are refused until it is set.
# Comma-separate several chats to authorise more than one.
TELEGRAM_CHAT_ID=

# AI provider API key for NVIDIA
NVIDIA_API_KEY=
# Legacy names kept for compatibility with older environments
# OPENROUTER_API_KEY=
# AGENTROUTER_API_KEY=

# Optional overrides (defaults below)
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# AI_MODEL_FALLBACK=minimax/minimax-m3:free,z-ai/glm-5.2:free,thinkingmachines/inkling:free,poolside/laguna-xs-2.1:free,cohere/north-mini-code:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,minimax/minimax-m2.7:free,nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# AI_DAILY_BUDGET=50
# LOG_LEVEL=INFO

# ---- Ollama (self-hosted LLM — the PRIMARY decision maker, Phase 4) ----
# Set BOTH to route every funnel-passing candidate to your local model via the
# OpenAI-compatible endpoint. Local providers are exempt from AI_DAILY_BUDGET.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen3:8b

# Optional: how strictly the AI provider is held to the JSON output contract.
# AI_JSON_MODE=0 disables `response_format={"type":"json_object"}` for the verdict
# batches (only needed if a gateway rejects the field — the bot detects a 400 that
# names it and disables it by itself, so leave this alone in practice).
# AI_JSON_MODE=1
# Ceiling for the token escalation a truncated reply triggers (0 disables it).
# AI_MAX_TOKENS_RETRY_CAP=12000

# ---- optional: tunable floors (defaults are the spec values; set only to run an
# experiment, and the bot prints a CONFIG: warning at startup if a value makes a
# rule stop meaning anything — e.g. zeroing both RR penalties AND MIN_RR leaves
# reward:risk enforced nowhere, which is the state the 2026-09-02 loosening ended in)
# MIN_RR=1.5                          minimum reward:risk
# QUALITY_MIN=50                       setup-quality floor for a tradable setup
# QUALITY_PRIMARY_FLOOR=45             primary evidence floor (indicators cannot rescue)
# ALERT_QUALITY_MIN=50                 Telegram alert floor (below = log-only)
# MIN_SCORE_1H=55                      funnel gates: which coins get decided
# MIN_SCORE_15M=50
# MIN_SCORE_5M=50
# MIN_CONFLUENCE=55
# DUPLICATE_COOLDOWN_MIN=20            same-coin alert cooldown (minutes)
# SCAN_DEADLINE_SECONDS=285            per-scan wall-clock budget (5-min slot is 300s)
# VOLUME_MIN_USDT=5000000              24h quote-volume universe filter ($5M)
